{
  "manifest_version": 3,
  "name": "Mobilism Enhancer",
  "version": "1.0.0",
  "description": "Enhance mobilism.me forum UX with smart topic sorting, hot topic highlighting, and filtering capabilities",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://forum.mobilism.me/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://forum.mobilism.me/viewforum.php*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
